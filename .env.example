# ====== LLM: Google Generative AI (Free Tier) ======
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_MODEL=gemini-1.5-flash

# Get key from: https://aistudio.google.com/app/apikeys

# ====== Local Database: SQLite ======
DATABASE_URL=sqlite:///./medi_triage.db

# ====== Local Cache: Redis ======
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ====== Local Vector Store: ChromaDB ======
VECTOR_STORE_TYPE=chromadb
VECTOR_STORE_PATH=./data/vector_store

# ====== Presidio Configuration ======
PRESIDIO_ANONYMIZER_THRESHOLD=0.5

# ====== Ragas Faithfulness Threshold ======
RAGAS_FAITHFULNESS_THRESHOLD=0.95

# ====== Logging ======
LOG_LEVEL=INFO
LOG_FORMAT=json

# ====== Environment ======
ENVIRONMENT=development
DEBUG=True